# Copiá este archivo a ".env" y completá con tus valores reales.
# NUNCA subas el archivo ".env" real a un repositorio.

# --- Base de datos (Supabase) ---
# Project Settings > Database > Connection String (usá el modo "Session pooler")
# Esta es la conexión de USO NORMAL, con el rol app_backend (RLS activo).
DATABASE_URL=postgresql://app_backend:TU_PASSWORD@TU-PROYECTO.pooler.supabase.com:5432/postgres

# Conexión separada, con el rol app_admin (BYPASSRLS) — creála en el SQL
# Editor de Supabase con:
#   CREATE ROLE app_admin LOGIN PASSWORD 'una-password-fuerte' BYPASSRLS;
#   GRANT ALL ON ALL TABLES IN SCHEMA public TO app_admin;
#   GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO app_admin;
# (BYPASSRLS ya le permite tocar todo — el GRANT es el permiso de tabla
# en sí, sin el cual ni siquiera BYPASSRLS alcanza)
DATABASE_URL_ADMIN=postgresql://app_admin:TU_PASSWORD@TU-PROYECTO.pooler.supabase.com:5432/postgres

# --- Mercado Libre ---
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=https://tu-subdominio.ngrok-free.app/callback
MELI_SITE_ID=MLA

# --- IA (Chat IA, Costos por chat, mensaje "coach" de Logros — opcional) ---
# Cualquier proveedor compatible con el formato de Chat Completions de
# OpenAI sirve (DeepSeek, OpenRouter, Groq, etc.) — solo cambian estos
# 3 valores. Ejemplo con DeepSeek (https://api-docs.deepseek.com):
IA_API_KEY=
IA_BASE_URL=https://api.deepseek.com
IA_MODEL=deepseek-flash

# --- Seguridad ---
# Generá con: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Generá con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Panel de administración ---
# El email del dueño de CoreLux — la única persona que puede acceder a /admin.
# Si lo dejás vacío, /admin devuelve 403 siempre.
ADMIN_EMAIL=tu@email.com

FLASK_DEBUG=false
# ⚠️ NUNCA pongas esto en "true" mientras la app esté expuesta por ngrok o
# cualquier URL pública — con debug activado, un error muestra una consola
# de Python interactiva en el navegador de QUIEN SEA que la vea, lo que
# equivale a ejecución de código remoto en tu máquina. Usalo en "true"
# solo en tu PC, sin ngrok corriendo al mismo tiempo, y volvé a "false"
# antes de exponer la app de nuevo.
