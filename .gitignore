venv/
__pycache__/
*.pyc
.env
*.log
.vscode/

# Estado local de Celery Beat corriendo en dev — no es código, es una
# base SQLite de runtime, cambia en cada arranque y no aporta nada
# versionado (además pisa el archivo de otro dev sin sentido).
celerybeat-schedule
celerybeat-schedule-shm
celerybeat-schedule-wal

# .agents/ era la ubicación vieja/incorrecta (Claude Code no la lee) —
# el contenido real ya vive en .claude/skills/, que SÍ se versiona a
# propósito para que cualquier sesión (local o en la nube) tenga las
# mismas skills activas.
.agents/
skills-lock.json

# Respaldos locales de la base (datos de todos los usuarios: nunca al repositorio)
respaldos/

# Vistas previas temporales de pantallas (no se versionan)
static/_prev/
