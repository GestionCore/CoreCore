[Unit]
Description=CoreLux - Celery worker
After=network.target redis-server.service

[Service]
Type=simple
User=corelux
Group=corelux
WorkingDirectory=/opt/corelux
EnvironmentFile=/opt/corelux/.env
ExecStart=/opt/corelux/venv/bin/celery -A celery_app worker --concurrency=4 --loglevel=info
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
